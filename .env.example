# ==============================================================================
# FRIENDLY CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production: let the reverse proxy send /api/* to the API and set API_PROXY=external so the web server does not forward it.
# API_PROXY=external

# ------------------------------------------------------------------------------
# 1. DATABASE & POSTGRESQL RLS (Row-Level Security)
# ------------------------------------------------------------------------------
# Migration / Superuser connection (used exclusively by Drizzle Kit migrations)
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/friendly_crm

# Restricted Runtime role (enforces RLS; cannot bypass tenant policies). Use this in production.
# The role is created by migration 0002 as friendly_app_runtime with a PLACEHOLDER password: change it before real use
# (ALTER ROLE friendly_app_runtime PASSWORD '...'). See docs/row-level-security.md.
DATABASE_URL=postgresql://friendly_app_runtime:CHANGE_ME@localhost:5432/friendly_crm

# Read-only replica connection pool (optional)
DATABASE_RO_URL=postgresql://friendly_ro:friendly_ro_pass@localhost:5432/friendly_crm

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION MANAGEMENT
# ------------------------------------------------------------------------------
# High-entropy secret for HMAC-SHA256 session tokens (minimum 32 characters)
JWT_SECRET=super_secret_jwt_friendly_crm_min_32_characters_for_security_12345
SESSION_TTL_HOURS=24

# Set to 'true' in local development and CI testing to enable in-memory SMS gateway
ENABLE_DEV_SMS_GATEWAY=true

# Real sign-in SMS through Fast2SMS. When FAST2SMS_API_KEY is set, codes are sent by SMS instead of shown on the
# login page. In production set ENABLE_DEV_SMS_GATEWAY=false and set the key.
# FAST2SMS_API_KEY=
# 'otp' (default) needs no DLT template. 'dlt' uses your approved template and also needs the two lines below.
# FAST2SMS_ROUTE=otp
# FAST2SMS_SENDER_ID=
# FAST2SMS_TEMPLATE_ID=

# Local development with NO Postgres only: lets sign-in fall back to process memory. Off by default so a database
# error shows up as an error instead of being hidden. Ignored in production.
# ALLOW_MEMORY_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. WHATSAPP & MESSAGING GATEWAY
# ------------------------------------------------------------------------------
# WAHA / Hostinger WhatsApp Gateway Base URL
HOSTINGER_WHATSAPP_API_URL=https://whatsapp.friendlycrm.in
HOSTINGER_WHATSAPP_API_KEY=your_hostinger_whatsapp_api_key_here

# Twilio WhatsApp (see docs/twilio-whatsapp.md). Used for sending once the account, token and a sender are all set.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_MESSAGING_SERVICE_SID=      (instead of TWILIO_WHATSAPP_FROM)
# The exact address entered in Twilio for incoming messages and delivery reports (Twilio signs it):
# TWILIO_WEBHOOK_URL=https://api.yourshop.in/api/notifications/twilio/webhook
# TWILIO_STATUS_CALLBACK_URL=https://api.yourshop.in/api/notifications/twilio/webhook
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# For `npm run check:twilio` only: a number that may receive one test message
# TWILIO_TEST_TO=

# Webhook secrets. In production these are REQUIRED (there is no built-in default).
#   WHATSAPP_VERIFY_TOKEN : the "Verify token" you type into Meta's webhook settings (GET challenge)
#   WHATSAPP_APP_SECRET   : your Meta App Secret; it signs every POST (x-hub-signature-256)
# WHATSAPP_WEBHOOK_SECRET is the legacy single secret and is only a fallback for the two above.
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=change-me-app-secret
WHATSAPP_WEBHOOK_SECRET=dev-webhook-secret

# Customers texting their own number can see their order status/balance. Set to 'false' to switch it off.
ENABLE_CUSTOMER_SELF_SERVICE=true

# Outbound Outbox Worker Configuration
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5

# ------------------------------------------------------------------------------
# 4. PAYMENTS: none. There is no payment gateway or third-party partner. Customers are shown the business's bank
#    details and UPI ID (set in Settings) and a UPI QR code on invoices; staff record each payment when it arrives.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (SMTP / Resend / SendGrid)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=dev
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@friendlycrm.in
SMTP_PASS=your_smtp_password
EMAIL_FROM="Friendly CRM <notifications@friendlycrm.in>"

# 9. CUSTOMER QUOTE LINKS (the PDF link sent on WhatsApp)
# PUBLIC_API_URL is the address customers' phones can reach the API at, e.g. https://api.yourshop.in
# QUOTE_LINK_SECRET signs the links so they cannot be guessed or edited: 16+ random characters, kept private.
# Without both, production sends no PDF link (never a broken one). In development both default to local values.
PUBLIC_API_URL=
QUOTE_LINK_SECRET=

# Reads an enquiry's handwritten notes, photos and PDFs to pre-fill the quotation (staff still check every line).
# Leave it empty until you have a key: the button still works on typed and spoken words, PDF text and printed photos.
# With a key it also reads handwriting and scanned PDFs. Files are sent to Anthropic only when staff press that button.
# Optional: QUOTE_READER_MODEL (default claude-sonnet-5-5).
#
# The same key also powers 'Ask AI to compare' on the Add customer and Add product forms: a second opinion (same /
# different / not sure, with a reason) on the few records the plain name checks found. It runs only when a person presses
# the button, at most 30 times an hour for each business, and sends only names and the GST state (products: unit, HSN and
# rate), never phone numbers, addresses or balances. It only advises. Optional: ANTHROPIC_DUPLICATE_MODEL (default claude-haiku-5-5).
# This must be a real Anthropic key (it starts with sk-ant-). Keep it in .env, never in this example file.
ANTHROPIC_API_KEY=

# Reading without an Anthropic key: typed and spoken words, text inside PDFs and printed text in photos are always read
# on this server (English OCR; the language file is downloaded once into OCR_CACHE_DIR, default: system temp folder).
# Handwriting needs a vision model: either ANTHROPIC_API_KEY above, or one on your own machine through Ollama:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl
OCR_CACHE_DIR=

# Creating a business (POST /api/tenant/onboard). Open in development and tests; in PRODUCTION it is closed unless:
#  - ONBOARDING_KEY is set (16+ random characters): the operator creates a business by sending it in the x-onboarding-key
#    header, for example:  curl -X POST https://your-api/api/tenant/onboard -H "x-onboarding-key: <key>" -H "content-type: application/json" -d '{...}'
#  - or ALLOW_PUBLIC_SIGNUP=true: anyone may sign up, at most 5 a hour for each address. Leave it off for a pilot.
ONBOARDING_KEY=
ALLOW_PUBLIC_SIGNUP=false
